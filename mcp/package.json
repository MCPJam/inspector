{
  "name": "@mcpjam/mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MCPJam remote MCP server (Cloudflare Worker)",
  "scripts": {
    "build:ui": "vite build --config vite.config.ts",
    "bundle:ui:html": "node scripts/bundle-mcp-app-html.mjs",
    "bundle:skills": "node scripts/generate-skills-bundle.mjs",
    "test": "npm run build -w @mcpjam/sdk && npm run build:ui && vitest run",
    "test:fast": "npm run build:ui && vitest run",
    "ui:watch": "vite build --config vite.config.ts --watch --mode development",
    "dev": "npm run build:ui && wrangler dev --env staging",
    "dev:local": "npm run build:ui && wrangler dev --env dev",
    "start": "npm run build:ui && wrangler dev --env staging",
    "deploy:staging": "npm run build:ui && wrangler deploy --env staging",
    "deploy": "npm run build:ui && wrangler deploy",
    "typecheck": "npm run build -w @mcpjam/sdk && npm run build:ui && tsc --noEmit",
    "typecheck:fast": "npm run build:ui && tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@mcpjam/design-system": "*",
    "@mcpjam/sdk": "*",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@modelcontextprotocol/server": "2.2.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.1"
  }
}
