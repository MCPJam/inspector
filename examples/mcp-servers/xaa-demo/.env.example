# Copy this file to `.env` to override the server's built-in defaults, then
# restart. The server loads `.env` automatically.

# Port the demo server listens on.
PORT=8080

# The audience the MCP endpoint REQUIRES on incoming access tokens.
#
# The server's built-in default (used when there is NO .env file) is the WRONG
# public URL `https://demo.example.com/mcp` — that's the bug the how-to guide
# reproduces. Copying this file to `.env` sets the audience to your real local
# URL, which is the fix:
CANONICAL_URL=http://localhost:8080/mcp

# Optional: pin the identity issuer you trust. Leave empty for the demo
# (the server trusts the pass's own issuer after verifying its signature).
# In production, ALWAYS set this to your IdP's issuer URL.
TRUSTED_ISSUER=
