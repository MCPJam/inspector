{
  "name": "@mcpjam/vitest",
  "version": "0.2.1",
  "description": "Run MCPJam eval suites inside vitest: one test per eval case, plus a gate test that fails the build on a policy breach.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:packaging": "node tests/packaging.e2e.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vitest": ">=3.2.0 <5"
  },
  "dependencies": {
    "@mcpjam/sdk": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.3.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
