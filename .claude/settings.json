{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$GITHUB_ACTIONS$CI\" ] || node \"$CLAUDE_PROJECT_DIR/scripts/slop/hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$GITHUB_ACTIONS$CI\" ] || node \"$CLAUDE_PROJECT_DIR/scripts/slop/hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$GITHUB_ACTIONS$CI\" ] || node \"$CLAUDE_PROJECT_DIR/scripts/slop/hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
