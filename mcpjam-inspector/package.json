{
  "name": "@mcpjam/inspector",
  "productName": "MCPJam Inspector",
  "version": "3.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "MCPJam Inspector",
  "license": "Apache-2.0",
  "author": "MCPJam (https://mcpjam.com)",
  "homepage": "https://mcpjam.com",
  "bugs": "https://github.com/mcpjam/inspector/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/MCPJam/inspector.git"
  },
  "main": ".vite/build/main.cjs",
  "bin": {
    "inspector": "bin/start.js",
    "inspector-vite": "bin/start.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/launcher/index.d.ts",
      "import": "./dist/lib/launcher/index.js",
      "require": "./dist/lib/launcher/index.cjs"
    },
    "./vite": {
      "types": "./dist/lib/vite/index.d.ts",
      "import": "./dist/lib/vite/index.js",
      "require": "./dist/lib/vite/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map",
    "assets/icon.ico",
    "assets/icon.icns",
    ".env.production",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "predev": "node scripts/check-dev-env.mjs --task=dev && npm run sdk:build && npm run bundle:all",
    "dev": "node scripts/dev-session-token.mjs dev:processes",
    "dev:worker": "npm --prefix ../mcp run dev:local",
    "predev:app": "node scripts/check-dev-env.mjs --task=dev && npm run sdk:build && npm run bundle:all",
    "dev:app": "node scripts/dev-session-token.mjs dev:app:processes",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "dev:setup-guest-auth": "node scripts/dev-setup-guest-auth.mjs",
    "worktree": "node scripts/worktree.mjs",
    "dev:hosted": "cross-env VITE_MCPJAM_HOSTED_MODE=true WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 npm run dev",
    "sdk:build": "npm --prefix ../sdk run build",
    "dev:convex": "convex dev",
    "dev:server": "cross-env ENVIRONMENT=dev NODE_ENV=development ALLOW_LOCAL_DEV_SERVICE_TOKEN=true tsx watch --tsconfig server/tsconfig.json --include 'evals-cli/src/**/*.ts' --exclude 'evals-cli/dist/**' --exclude 'evals-cli/node_modules/**' server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:client:clean": "rm -rf node_modules/.vite && FORCE_OPTIMIZE=true vite --config client/vite.config.ts",
    "build": "npm run clean && npm run build:sdk && npm run bundle:sandbox-proxies && npm run bundle:browser-harness && npm run bundle:plugin-shim && npm run bundle:codex-appserver-bridge && npm run bundle:local-harness-layer && npm run build:lib && npm run build:client && npm run build:server",
    "build:sdk": "npm run sdk:build",
    "bundle:chatgpt": "npm --prefix ../sdk run bundle:chatgpt-runtime",
    "bundle:mcp-apps": "npm --prefix ../sdk run bundle:mcp-apps-runtime",
    "bundle:sandbox-proxies": "node scripts/bundle-sandbox-proxy-html.js",
    "bundle:browser-harness": "node scripts/bundle-browser-harness.mjs",
    "bundle:plugin-shim": "node scripts/bundle-plugin-shim.mjs",
    "bundle:codex-appserver-bridge": "node scripts/bundle-codex-appserver-bridge.mjs",
    "bundle:local-harness-layer": "node scripts/bundle-local-harness-layer.mjs",
    "bundle:all": "npm run bundle:sandbox-proxies && npm run bundle:browser-harness && npm run bundle:plugin-shim && npm run bundle:codex-appserver-bridge && npm run bundle:local-harness-layer",
    "bundle:browserd": "node scripts/bundle-browserd.mjs",
    "clean": "rm -rf dist out .vite client/dist",
    "clean:all": "rm -rf dist out .vite client/dist node_modules sdk/node_modules",
    "deps:ci": "npm --prefix .. ci --legacy-peer-deps --cache .npm-cache",
    "build:lib": "tsup --config lib/tsup.config.ts",
    "build:client": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vite build --config client/vite.config.ts",
    "pretypecheck:client": "npm run check:renderer-tier-b && npm run check:browser-viewer",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.typecheck.json",
    "typecheck:server": "node scripts/typecheck-server.mjs",
    "check:renderer-tier-b": "node client/scripts/check-renderer-tier-b-imports.mjs",
    "build:client:clean": "rm -rf node_modules/.vite && cross-env FORCE_OPTIMIZE=true NODE_OPTIONS=--max-old-space-size=6144 vite build --config client/vite.config.ts",
    "build:server": "tsup --config server/tsup.config.ts",
    "start": "cross-env NODE_ENV=production node bin/start.js",
    "prettier-fix": "prettier --write .",
    "install:deps": "npm --prefix .. install --legacy-peer-deps",
    "docker:build": "docker build -t mcpjam/mcp-inspector:local -f Dockerfile ..",
    "docker:start": "docker run -d -p 127.0.0.1:6274:6274 --name mcp-inspector --pull=never mcpjam/mcp-inspector:local",
    "docker:stop": "docker stop mcp-inspector && docker rm mcp-inspector || true",
    "docker:dev": "npm run docker:stop; npm run docker:build && npm run docker:start",
    "electron:start": "npm run electron:dev",
    "preelectron:package": "node scripts/check-dev-env.mjs --task=electron-package",
    "electron:package": "cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-forge package",
    "icons:win": "node scripts/generate-windows-icon.mjs",
    "icons:mac": "node scripts/generate-mac-icon.mjs",
    "preelectron:make": "node scripts/check-dev-env.mjs --task=electron-make",
    "electron:make": "npm run icons:win && npm run icons:mac && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-forge make",
    "electron:fix:dmg-deps": "npm --prefix .. rebuild macos-alias fs-xattr",
    "electron:install": "APP='out/MCPJam Inspector-darwin-arm64/MCPJam Inspector.app'; test -d \"$APP\" || { echo \"electron:install: $APP not found; run 'npm run electron:package' first (this script only copies a packaged app, and it removes the installed one before copying)\" >&2; exit 1; }; killall 'MCPJam Inspector' 2>/dev/null || true; rm -rf '/Applications/MCPJam Inspector.app' && cp -r \"$APP\" /Applications/ && open '/Applications/MCPJam Inspector.app'",
    "electron:publish": "cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-forge publish",
    "preelectron:dev": "node scripts/check-dev-env.mjs --task=electron-dev && node scripts/build-sdk-if-stale.mjs && npm run bundle:all",
    "electron:dev": "node scripts/electron-dev.mjs",
    "pretest": "npm run build -w @mcpjam/evaluators && npm run bundle:runtimes -w @mcpjam/sdk && node scripts/bundle-sandbox-proxy-html.js && node scripts/bundle-browser-harness.mjs && node scripts/bundle-plugin-shim.mjs && node scripts/bundle-codex-appserver-bridge.mjs && node scripts/bundle-local-harness-layer.mjs && node scripts/bundle-browserd.mjs --check",
    "test": "node --test scripts/__tests__/*.test.mjs && cross-env NODE_OPTIONS=--max-old-space-size=6144 vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local-access": "playwright test -c playwright.local-access.config.ts",
    "test:github-checks-cleanup:e2b": "cross-env RUN_GITHUB_CHECKS_E2B_CLEANUP=1 vitest run server/services/github-checks/__tests__/cleanup.e2b.integration.test.ts",
    "test:e2e:oauth-debugger": "npm run sdk:build && playwright test -c playwright.oauth-debugger.config.ts",
    "ship": "bash scripts/ship.sh",
    "check:browser-viewer": "node client/scripts/check-browser-viewer-imports.mjs",
    "pretest:watch": "npm run build -w @mcpjam/evaluators",
    "pretest:coverage": "npm run build -w @mcpjam/evaluators",
    "test:swarm-reporting:smoke": "playwright test --config playwright.swarm-reporting.config.ts",
    "dev:processes": "run-script-os",
    "dev:processes:default": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:worker\"",
    "dev:processes:win32": "concurrently --raw \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:worker\"",
    "dev:app:processes": "run-script-os",
    "dev:app:processes:default": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:app:processes:win32": "concurrently --raw \"npm run dev:server\" \"npm run dev:client\""
  },
