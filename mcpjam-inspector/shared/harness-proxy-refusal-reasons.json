  "reasons": {
    "spend_budget_reached": { "retry": false, "class": null },
    "spending_limit_reached": { "retry": false, "class": null },
    "spend_admission": { "retry": false, "class": null },
    "pricing_unavailable": { "retry": false, "class": null },
    "gateway_not_configured": { "retry": false, "class": null },
    "lease_budget_exhausted": { "retry": false, "class": null },
    "lease_max_calls": { "retry": false, "class": null },
    "lease_daily_harness_spend": { "retry": false, "class": null },
    "lease_daily_harness_calls": { "retry": false, "class": null },
    "no_billable_usage": { "retry": true, "class": null },
    "proxy_error": { "retry": true, "class": null },
    "org_keys_required": { "retry": false, "class": "configuration" },
    "ai_key_policy_unavailable": { "retry": false, "class": "configuration" },
    "byok_credential_rejected": { "retry": false, "class": "auth" },
    "byok_credential_unavailable": { "retry": false, "class": "configuration" },
    "byok_connection_changed": { "retry": false, "class": "configuration" },
    "transport_request_too_large": { "retry": false, "class": null },
    "transport_response_too_large": { "retry": false, "class": null },
    "upstream_timeout": { "retry": false, "class": "provider_unavailable" },
    "upstream_interrupted": { "retry": false, "class": "provider_unavailable" },
    "upstream_unreachable": { "retry": true, "class": "provider_unavailable" },
    "upstream_redirect": { "retry": false, "class": "configuration" }
  }
}
