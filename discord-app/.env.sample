# ─── Gateway ────────────────────────────────────────────────────────────────
# The bot's Discord token, from the Discord developer portal → Bot. The one
# variable with no fallback: without it the app throws at boot rather than
# connecting as nobody.
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# The agent is OFF unless this is exactly "true". Not a typo-tolerant check:
# a bot that answers when it should not is worse than one that stays quiet, and
# this app is deployed before the agent is meant to be live.
POSTHOG_DISCORD_AGENT_ENABLED=false

# ─── The two service credentials ────────────────────────────────────────────
# THESE ARE NOT INTERCHANGEABLE. They authenticate to different services, and
# there is deliberately NO fallback from one to the other — handing a service
# the other's token is an authentication failure, not a degraded mode.
#
# DISCORD_SERVICE_TOKEN
#   → the CONVEX backend's /agent/* surface: event claims, thread bindings,
#     presence. Sent as the `x-discord-service-token` header. Set the same
#     value as DISCORD_SERVICE_TOKEN on the Convex deployment.
#
# MCPJAM_DISCORD_SERVICE_TOKEN
#   → the INSPECTOR's /api/v1 and /api/surface-link/session. A `dsc_` bearer,
#     checked against MCPJAM_DISCORD_SERVICE_TOKEN_HASH (the SHA-256 of this
#     value) which is set on the Inspector, not here.
#
# This mirrors the Slack app's split: two services, two trust boundaries, two
# rotations.
DISCORD_SERVICE_TOKEN=YOUR_DISCORD_SERVICE_TOKEN
MCPJAM_DISCORD_SERVICE_TOKEN=dsc_YOUR_INSPECTOR_SERVICE_TOKEN

# ─── Endpoints ──────────────────────────────────────────────────────────────
# Where agent turns and connect links go. Defaults to https://app.mcpjam.com.
# MCPJAM_BASE_URL=https://app.mcpjam.com

# Convex HTTP URL, for install/uninstall presence. Unset ⇒ presence is a
# silent no-op; nothing else is affected.
# MCPJAM_CONVEX_HTTP_URL=https://YOUR-DEPLOYMENT.convex.site

# Public app URL used in links shown to a human. Defaults to MCPJAM_BASE_URL's
# production default.
# MCPJAM_APP_URL=https://app.mcpjam.com

# Extra origin a connect link may point at (a preview deploy, a tunnel).
# The allowlist is MCPJAM_APP_URL + this + MCPJAM_BASE_URL. Entries are
# normalized to their origin and a malformed one is SKIPPED — a typo narrows
# the allowlist, it never widens it.
# DISCORD_LINK_PUBLIC_ORIGIN=https://preview.example.com

# ─── Slash-command registration ─────────────────────────────────────────────
# Both required, or registration is skipped entirely. Guild-scoped, so commands
# appear instantly in that one server — the right shape for development.
# DISCORD_APPLICATION_ID=YOUR_DISCORD_APPLICATION_ID
# DISCORD_GUILD_ID=YOUR_TEST_GUILD_ID

# ─── Legacy ─────────────────────────────────────────────────────────────────
# Single-project fallback from before per-user linking. A real install resolves
# the project from the linked account; this is consulted only when nothing else
# answers. Leave unset on a new deployment.
# MCPJAM_PROJECT_ID=
