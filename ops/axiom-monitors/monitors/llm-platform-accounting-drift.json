{
  "key": "llm-platform-accounting-drift",
  "name": "MCPJam platform accounting drift",
  "tier": "WARN",
  "owner": "marcelo",
  "dataset": "mcpjam-backend-prod",
  "notifier": "llm-safety",
  "monitor": {
    "type": "Threshold",
    "columnName": "DriftMicros",
    "operator": "Above",
    "threshold": 999999,
    "rangeMinutes": 1440,
    "intervalMinutes": 60,
    "triggerAfterNPositiveResults": 1,
    "triggerFromNRuns": 1,
    "notifyByGroup": false,
    "alertOnNoData": false,
    "resolvable": true,
    "notifyEveryRun": false
  },
  "aplQuery": [
    "['mcpjam-backend-prod']",
    "| where _sysTime >= ago(24h)",
    "| extend msg=tostring(['data.message'])",
    "| where msg contains '\"event\":\"llm_spend_platform_reconciled\"'",
    "| summarize DriftMicros=sum(abs(tolong(extract('\"driftMicros\":(-?[0-9]+)', 1, msg))))"
  ],
  "description": [
    "WARN: closed platform buckets differ from their reservation ledgers by at least $1. Inspect settlement backlog and reservation IDs before repairing accounting. See backend docs/runbooks/abuse-containment.md."
  ],
  "rationale": [
    "Extends the existing llm-safety notifier; no live monitor is created by this definition."
  ]
}
