{
  "key": "llm-platform-free-switch-off",
  "name": "MCPJam platform free switch off",
  "tier": "WARN",
  "owner": "marcelo",
  "dataset": "mcpjam-backend-prod",
  "notifier": "llm-safety",
  "monitor": {
    "type": "Threshold",
    "columnName": "DisabledMs",
    "operator": "Above",
    "threshold": 86400000,
    "rangeMinutes": 5,
    "intervalMinutes": 5,
    "triggerAfterNPositiveResults": 1,
    "triggerFromNRuns": 1,
    "notifyByGroup": false,
    "alertOnNoData": false,
    "resolvable": true,
    "notifyEveryRun": false
  },
  "aplQuery": [
    "['mcpjam-backend-prod']",
    "| where _sysTime >= ago(5m)",
    "| extend msg=tostring(['data.message'])",
    "| where msg contains '\"event\":\"llm_spend_platform_switch_state\"' ",
    "| summarize DisabledMs=max(tolong(extract('\"disabledForMs\":([0-9]+)', 1, msg)))"
  ],
  "description": [
    "See mcpjam-backend/docs/runbooks/abuse-containment.md.",
    "Inspect admission reason, settlement backlog, and current deployed version before changing caps."
  ],
  "rationale": [
    "Extends the existing llm-safety notifier; no live monitor is created by this definition."
  ]
}
