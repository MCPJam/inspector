{
  "schemaVersion": "2",
  "mode": "agentWorkflow",
  "reportingMode": "standard",
  "suite": {
    "id": "s_arithmetic_smoke",
    "name": "Arithmetic smoke"
  },
  "target": {
    "servers": [
      {
        "name": "Arithmetic"
      }
    ]
  },
  "defaults": {
    "judge": {
      "enabled": false
    },
    "model": "anthropic/claude-haiku-4.5",
    "iterations": 3,
    "passThreshold": 1,
    "validity": {}
  },
  "cases": [
    {
      "id": "c_add_2_3",
      "title": "Add two numbers and return five",
      "steps": [
        {
          "id": "s1",
          "kind": "toolCall",
          "serverName": "Arithmetic",
          "toolName": "add",
          "arguments": {
            "a": 2,
            "b": 3
          }
        },
        {
          "id": "a1",
          "kind": "assert",
          "assertion": {
            "type": "toolCalledWith",
            "toolName": "add",
            "args": {
              "args": {
                "a": 2,
                "b": 3
              },
              "argumentMatching": "exact"
            }
          }
        },
        {
          "id": "a2",
          "kind": "assert",
          "assertion": {
            "type": "toolResultContains",
            "toolName": "add",
            "needle": "5"
          }
        }
      ]
    }
  ]
}
