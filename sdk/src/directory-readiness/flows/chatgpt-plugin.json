{
  "title": "Upload new or existing plugin",
  "steps": {
    "upload": {
      "title": "Upload your plugin ZIP",
      "intro": "Compress your plugin folder into a .zip file before uploading",
      "layout": {
        "blocks": [
          {
            "widget": "upload",
            "text": {
              "drop": "Upload new or existing plugin",
              "button": "Upload plugin",
              "checked": "Errors block the upload; warnings require confirmation."
            }
          }
        ]
      }
    },
    "listing": {
      "title": "Metadata & Skills",
      "intro": "Package details are read-only here; edit them in your source package.",
      "layout": {
        "blocks": [
          {
            "widget": "plugin-header",
            "fields": [
              "listing.displayName",
              "listing.shortDescription"
            ]
          },
          {
            "heading": "Metadata",
            "fields": [
              "listing.description",
              "listing.developer",
              "listing.name",
              "listing.category",
              "listing.capabilities",
              "listing.website",
              "listing.support",
              "listing.privacyPolicy",
              "listing.terms",
              "listing.starterPrompts"
            ],
            "text": {
              "upload": "Upload new version"
            }
          },
          {
            "heading": "Skills",
            "widget": "skills",
            "text": {
              "passed": "Checks passed",
              "attention": "Needs attention"
            }
          },
          {
            "widget": "findings",
            "text": {
              "title": "Findings",
              "all": "All",
              "blocking": "Blocking",
              "copy": "Copy findings"
            }
          }
        ]
      }
    },
    "mcp": {
      "title": "MCPs",
      "intro": "Your package can declare multiple MCP servers, but only one MCP server can be connected per plugin.",
      "layout": {
        "blocks": [
          {
            "heading": "Connect MCP server",
            "widget": "connect",
            "fields": [
              "mcp.serverUrl",
              "mcp.verificationToken"
            ],
            "text": {
              "authentication": "Authentication",
              "authorize": "Your MCP server needs OAuth access before we can scan its tools.",
              "settings": "You can define advanced settings in your mcp.json",
              "domain": "Domain verification",
              "verified": "Domain verified",
              "reconnect": "Reconnect",
              "rescan": "Rescan"
            }
          },
          {
            "heading": "Tools",
            "widget": "tools"
          }
        ]
      }
    },
    "reviewer": {
      "title": "Review information",
      "intro": "Read-only fields are managed by your plugin ZIP. To change read-only information, update your plugin ZIP and upload it again.",
      "layout": {
        "blocks": [
          {
            "heading": "Countries and translations",
            "note": "Its fields were not captured."
          },
          {
            "heading": "Reviewer credentials",
            "note": "Test credentials must work immediately with no additional setup required. Logging in must provide immediate access to a demo account.",
            "fields": [
              "reviewer.loginUrl",
              "reviewer.tenant",
              "reviewer.username",
              "reviewer.passwordSecret",
              "reviewer.signInSteps"
            ]
          },
          {
            "fields": [
              "reviewer.identityTool",
              "reviewer.identityArgs",
              "reviewer.expectedIdentityPath",
              "reviewer.expectedIdentity",
              "reviewer.expectedOrganizationPath",
              "reviewer.expectedOrganization",
              "reviewer.fixtures"
            ]
          },
          {
            "heading": "Test cases",
            "fields": [
              "reviewer.testCases"
            ]
          },
          {
            "heading": "Negative test cases",
            "fields": [
              "reviewer.negativeTestCases"
            ]
          },
          {
            "heading": "Supporting content",
            "fields": [
              "reviewer.demoRecordingUrl",
              "reviewer.releaseNotes"
            ]
          },
          {
            "widget": "drawer-actions",
            "text": {
              "back": "Back",
              "next": "Next",
              "save": "Save details"
            }
          }
        ]
      }
    },
    "submit": {
      "title": "Submit for review",
      "intro": "Complete the required policy attestations.",
      "layout": {
        "blocks": [
          {
            "fields": [
              "submit.developerIdentity"
            ]
          },
          {
            "fields": [
              "submit.attestations"
            ]
          },
          {
            "widget": "non-blocking-findings",
            "text": {
              "title": "Non-blocking findings",
              "body": "These findings do not block submission, but unresolved findings may lead to rejection during review."
            }
          },
          {
            "fields": [
              "submit.additionalContext"
            ]
          },
          {
            "widget": "submit",
            "text": {
              "cancel": "Cancel",
              "submit": "Submit"
            }
          }
        ]
      }
    },
    "publish": {
      "title": "Publish your approved plugin",
      "intro": "Open the approved package version and select Publish plugin.",
      "layout": {
        "blocks": [
          {
            "widget": "publish",
            "text": {
              "button": "Publish plugin"
            }
          }
        ]
      }
    }
  },
  "fields": {
    "listing.displayName": {
      "label": "Display name",
      "packagePath": "plugin.json#/extensions/com.openai/interface/displayName",
      "errors": {
        "required": "Display name is required, non-empty, and single-line.",
        "tooLong": "Display name must be 30 characters or fewer."
      }
    },
    "listing.shortDescription": {
      "label": "Short description",
      "packagePath": "plugin.json#/extensions/com.openai/interface/shortDescription",
      "errors": {
        "required": "Short description is required, non-empty, and single-line.",
        "tooLong": "Short description must be 30 characters or fewer."
      }
    },
    "listing.description": {
      "label": "About",
      "packagePath": "plugin.json#/extensions/com.openai/interface/longDescription",
      "errors": {
        "required": "Long description is required and must be non-empty. Line breaks are allowed.",
        "tooLong": "Long description must be 4,000 characters or fewer."
      }
    },
    "listing.developer": {
      "label": "Developer",
      "packagePath": "plugin.json#/extensions/com.openai/interface/developerName",
      "errors": {
        "required": "Developer name is required.",
        "tooLong": "Developer name must be 80 characters or fewer."
      }
    },
    "listing.name": {
      "label": "Package name",
      "packagePath": "plugin.json#/name"
    },
    "listing.category": {
      "label": "Category",
      "packagePath": "plugin.json#/extensions/com.openai/interface/category",
      "options": [
        {
          "value": "Productivity",
          "label": "Productivity"
        },
        {
          "value": "Creativity",
          "label": "Creativity"
        },
        {
          "value": "Developer Tools",
          "label": "Developer Tools"
        },
        {
          "value": "Business & Operations",
          "label": "Business & Operations"
        },
        {
          "value": "Data & Analytics",
          "label": "Data & Analytics"
        },
        {
          "value": "Communication",
          "label": "Communication"
        },
        {
          "value": "Education & Research",
          "label": "Education & Research"
        },
        {
          "value": "Security",
          "label": "Security"
        },
        {
          "value": "Finance",
          "label": "Finance"
        },
        {
          "value": "Healthcare",
          "label": "Healthcare"
        },
        {
          "value": "Travel",
          "label": "Travel"
        },
        {
          "value": "Entertainment",
          "label": "Entertainment"
        },
        {
          "value": "Other",
          "label": "Other"
        }
      ]
    },
    "listing.capabilities": {
      "label": "Capabilities",
      "packagePath": "plugin.json#/extensions/com.openai/interface/capabilities"
    },
    "listing.website": {
      "label": "Website",
      "packagePath": "plugin.json#/extensions/com.openai/interface/websiteURL",
      "errors": {
        "required": "Website URL is required."
      }
    },
    "listing.support": {
      "label": "Support",
      "packagePath": "plugin.json#/extensions/com.openai/interface/supportURL"
    },
    "listing.privacyPolicy": {
      "label": "Privacy policy",
      "packagePath": "plugin.json#/extensions/com.openai/interface/privacyPolicyURL"
    },
    "listing.terms": {
      "label": "Terms of service",
      "packagePath": "plugin.json#/extensions/com.openai/interface/termsOfServiceURL"
    },
    "listing.starterPrompts": {
      "label": "Starter prompts",
      "packagePath": "plugin.json#/extensions/com.openai/interface/defaultPrompt"
    },
    "mcp.serverUrl": {
      "label": "MCP Server URL",
      "packagePath": "mcp.json#/mcpServers/*/url"
    },
    "mcp.verificationToken": {
      "label": "Domain verification token",
      "helper": "The portal issues this token in its MCP step."
    },
    "reviewer.loginUrl": {
      "label": "Login URL"
    },
    "reviewer.tenant": {
      "label": "Tenant",
      "placeholder": "Choose an organization"
    },
    "reviewer.username": {
      "label": "Username"
    },
    "reviewer.passwordSecret": {
      "label": "Password",
      "placeholder": "Demo account password"
    },
    "reviewer.signInSteps": {
      "label": "Sign-in steps",
      "placeholder": "Steps for this account"
    },
    "reviewer.identityTool": {
      "label": "Identity tool",
      "placeholder": "whoami",
      "helper": "MCPJam's own check, not part of the portal: a read-only tool on your server that returns the signed-in account. MCPJam calls it as the reviewer."
    },
    "reviewer.identityArgs": {
      "label": "Identity tool arguments",
      "placeholder": "{}",
      "helper": "Fixed JSON arguments, if the identity tool takes any."
    },
    "reviewer.expectedIdentityPath": {
      "label": "Identity path",
      "placeholder": "$.user.email",
      "helper": "Where the tool's result names the account, as a JSON path."
    },
    "reviewer.expectedIdentity": {
      "label": "Expected reviewer",
      "placeholder": "review@example.com",
      "helper": "The account reviewers sign in as."
    },
    "reviewer.expectedOrganizationPath": {
      "label": "Organization path",
      "placeholder": "$.organization.name",
      "helper": "Where the tool's result names the organization or project, as a JSON path."
    },
    "reviewer.expectedOrganization": {
      "label": "Expected organization",
      "placeholder": "Sample Org",
      "helper": "The organization or project reviewers should land in."
    },
    "reviewer.fixtures": {
      "label": "Fixtures",
      "helper": "MCPJam's own check: resources your test cases name, each with a read-only tool call that finds it in the reviewer's account."
    },
    "reviewer.testCases": {
      "label": "Test cases",
      "packagePath": "plugin.json#/extensions/com.openai/review/test_cases/positive"
    },
    "reviewer.negativeTestCases": {
      "label": "Negative test cases",
      "packagePath": "plugin.json#/extensions/com.openai/review/test_cases/negative"
    },
    "reviewer.demoRecordingUrl": {
      "label": "Video walkthrough URL",
      "packagePath": "plugin.json#/extensions/com.openai/review/demo_recording_url"
    },
    "reviewer.releaseNotes": {
      "label": "Release notes",
      "packagePath": "plugin.json#/extensions/com.openai/publication/release_notes"
    },
    "submit.developerIdentity": {
      "label": "Developer identity"
    },
    "submit.attestations": {
      "label": "Policy attestations",
      "options": [
        {
          "value": "terms-and-guidelines",
          "label": "I have reviewed and agree to OpenAI's Terms and Plugin Guidelines. I confirm that my plugin is in compliance with those Terms and Guidelines."
        },
        {
          "value": "applicable-laws",
          "label": "I confirm that my plugin complies with all laws and regulations applicable to the industry it operates in. I understand that I am responsible for that compliance."
        },
        {
          "value": "no-money-movement",
          "label": "I confirm that my plugin does not initiate or execute money transfers, crypto transfers, or investment trades on behalf of users."
        },
        {
          "value": "third-party-rights",
          "label": "I confirm that I have all necessary rights to any third-party content or API endpoints accessed, displayed, or used by my plugin."
        },
        {
          "value": "suitable-under-18",
          "label": "I confirm that my plugin is suitable for individuals under 18 and does not include mature or adult content."
        },
        {
          "value": "not-targeting-children",
          "label": "I confirm that my plugin does not target children under 13 or share their personal information with OpenAI."
        }
      ]
    },
    "submit.additionalContext": {
      "label": "Additional Submission Context",
      "helper": "Add any additional information that might be useful for the review team, including justification for any findings. This optional note is private to the review."
    }
  },
