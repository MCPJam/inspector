      "default": "./dist/widget-runtime/index.js"
    },
    "./host-compat": {
      "types": "./dist/host-compat/index.d.ts",
      "import": "./dist/host-compat/index.js",
      "default": "./dist/host-compat/index.js"
    },
    "./plugin-bundle": {
      "types": "./dist/plugin-bundle/index.d.ts",
      "import": "./dist/plugin-bundle/index.js",
      "default": "./dist/plugin-bundle/index.js"
    },
    "./internal/plugin-host": {
      "types": "./dist/internal/plugin-host.d.ts",
      "import": "./dist/internal/plugin-host.js",
      "default": "./dist/internal/plugin-host.js"
    },
    "./oauth/node": {
      "types": "./dist/oauth/node.d.ts",
      "import": "./dist/oauth/node.js",
      "default": "./dist/oauth/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build -w @mcpjam/evaluators && npm run bundle:runtimes && cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "bundle:chatgpt-runtime": "node scripts/bundle-chatgpt-apps-runtime.mjs",
    "bundle:mcp-apps-runtime": "node scripts/bundle-mcp-apps-openai-compatible-runtime.mjs",
    "bundle:runtimes": "node ../scripts/generate-telemetry-catalogs.mjs && npm run bundle:chatgpt-runtime && npm run bundle:mcp-apps-runtime",
    "generate:eval-suite-schema": "tsx scripts/generate-eval-suite-schema.ts",
    "check:eval-suite-schema": "tsx scripts/generate-eval-suite-schema.ts --check",
    "generate:eval-verdict-policy-schema": "tsx scripts/generate-eval-verdict-policy-schema.ts",
    "check:eval-verdict-policy-schema": "tsx scripts/generate-eval-verdict-policy-schema.ts --check",
    "generate:host-catalog-fallback": "tsx scripts/generate-host-catalog-fallback.ts",
    "check:host-catalog-fallback": "tsx scripts/generate-host-catalog-fallback.ts --check",
    "check:host-catalog-fallback:remote": "node --import tsx scripts/check-host-catalog-fallback-remote.ts",
    "generate:decision-scan-catalogs": "tsx scripts/generate-decision-scan-catalogs.ts",
    "measure:decision-scan": "tsx scripts/measure-decision-scan.ts",
    "predev": "node ../scripts/generate-telemetry-catalogs.mjs",
    "dev": "concurrently -n telemetry,tsup \"node ../scripts/generate-telemetry-catalogs.mjs --watch\" \"tsup --watch\"",
    "sentry:inject": "sentry-cli sourcemaps inject ./dist",
    "sentry:sourcemaps": "npm run sentry:inject && sentry-cli sourcemaps upload --release=mcpjam-sdk@$(node -p \"require('./package.json').version\") --org=mcpjam-gh --project=mcpjam-sdk ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:packaging": "npm run build && npm run test:packaging:assert",
    "test:packaging:assert": "node scripts/assert-packaging.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prettier-fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "npm run sentry:inject --silent 1>&2",
    "pretest": "npm run build -w @mcpjam/evaluators && npm run bundle:runtimes",
    "pretest:watch": "npm run build -w @mcpjam/evaluators && npm run bundle:runtimes",
    "pretest:coverage": "npm run build -w @mcpjam/evaluators && npm run bundle:runtimes",
    "pretypecheck": "npm run build -w @mcpjam/evaluators && npm run bundle:runtimes",
    "pregenerate:eval-suite-schema": "npm run build -w @mcpjam/evaluators",
    "precheck:eval-suite-schema": "npm run build -w @mcpjam/evaluators",
    "pregenerate:eval-verdict-policy-schema": "npm run build -w @mcpjam/evaluators",
    "precheck:eval-verdict-policy-schema": "npm run build -w @mcpjam/evaluators"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "evals",
    "unit-testing",
    "e2e"
  ],
  "author": "MCPJam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MCPJam/inspector.git",
    "directory": "sdk"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@sentry/cli": "^3.8.0",
    "@sentry/node": "10.75.0",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.8",
    "tsup": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.113",
