    "details": [
      {
        "label": "client_id",
        "value": "https://www.mcpjam.c...",
      },
    ],
    "from": "authServer",
    "id": "received_client_credentials",
    "label": "Client Credentials",
    "to": "client",
  },
  {
    "description": "Client generates code verifier and challenge (recommended), includes resource parameter",
    "details": [
      {
        "label": "code_challenge",
        "value": "golden-code-cha...",
      },
      {
        "label": "method",
        "value": "S256",
      },
      {
        "label": "resource",
        "value": "https://mcp-server.example.com/mcp",
      },
      {
        "label": "Protocol",
        "value": "2025-03-26",
      },
    ],
    "from": "client",
    "id": "generate_pkce_parameters",
    "label": "Generate PKCE parameters",
    "to": "client",
  },
  {
    "description": "Client opens browser with authorization URL + code_challenge + resource",
    "details": [
      {
        "label": "code_challenge",
        "value": "golden-code-...",
      },
      {
        "label": "resource",
        "value": "https://mcp-server.example.com/mcp",
      },
    ],
    "from": "client",
    "id": "authorization_request",
    "label": "Open browser with authorization URL",
    "to": "browser",
  },
  {
    "description": "Browser navigates to authorization endpoint",
    "details": [
      {
        "label": "Note",
        "value": "User authorizes in browser",
      },
    ],
    "from": "browser",
    "id": "browser_to_auth_server",
    "label": "Authorization request with resource parameter",
    "to": "authServer",
  },
  {
    "description": "Authorization Server redirects browser back to callback URL",
    "details": [
      {
        "label": "code",
        "value": "golden-authorization...",
      },
    ],
    "from": "authServer",
    "id": "auth_redirect_to_browser",
    "label": "Redirect to callback with authorization code",
    "to": "browser",
  },
  {
    "description": "Browser redirects back to client with authorization code",
    "details": [
      {
        "label": "code",
        "value": "golden-authorization...",
      },
    ],
    "from": "browser",
    "id": "received_authorization_code",
    "label": "Authorization code callback",
    "to": "client",
  },
  {
    "description": "Client exchanges authorization code for access token",
    "details": [
      {
        "label": "grant_type",
        "value": "authorization_code",
      },
      {
        "label": "resource",
        "value": "https://mcp-server.example.com/mcp",
      },
    ],
    "from": "client",
    "id": "token_request",
    "label": "Token request + code_verifier + resource",
    "to": "authServer",
  },
  {
    "description": "Authorization Server returns access token",
    "details": [
      {
        "label": "token_type",
        "value": "Bearer",
      },
      {
        "label": "expires_in",
        "value": "3600",
      },
    ],
    "from": "authServer",
    "id": "received_access_token",
    "label": "Access token (+ refresh token)",
    "to": "client",
  },
  {
    "description": "Client makes authenticated request to MCP server",
    "details": [
      {
        "label": "POST",
        "value": "tools/list",
      },
      {
        "label": "Authorization",
        "value": "Bearer golden-access-t...",
      },
    ],
    "from": "client",
    "id": "authenticated_mcp_request",
    "label": "MCP request with access token",
    "to": "mcpServer",
  },
  {
    "description": "MCP Server returns successful response",
    "details": [
      {
        "label": "Status",
        "value": "200 OK",
      },
      {
        "label": "Content",
        "value": "tools, resources, prompts",
      },
    ],
    "from": "mcpServer",
    "id": "complete",
    "label": "MCP response",
    "to": "client",
  },
]
`;

