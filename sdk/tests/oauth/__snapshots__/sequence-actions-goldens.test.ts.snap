      },
    ],
    "from": "authServer",
    "id": "received_authorization_server_metadata",
    "label": "Authorization server metadata response",
    "to": "client",
  },
  {
    "description": "Client registers dynamically with Authorization Server",
    "details": [
      {
        "label": "Note",
