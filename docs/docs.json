        "tab": "Inspector",
        "groups": [
          {
            "group": "Connect",
            "icon": "plug",
            "pages": [
              "inspector/home",
              "inspector/clients",
              "inspector/connecting-servers",
              "inspector/projects",
              "inspector/plugins",
              "inspector/protocol-versions",
