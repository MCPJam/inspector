              "sdk/reference/oauth-emulation",
              "sdk/reference/apps-conformance",
              "sdk/reference/tasks-conformance",
              "sdk/reference/host-compat"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "tag": "Preview",
        "groups": [
          {
            "group": "API Guides",
            "icon": "map",
            "pages": ["reference/public-api", "reference/api-keys"]
